# ============================================================
# ЕМИАС-Discord — переменные окружения
# Скопируйте этот файл в .env и заполните значения.
# ============================================================

# Токен Discord-приложения (https://discord.com/developers)
DISCORD_TOKEN=your_bot_token_here

# Идентификатор приложения (клиента) Discord
CLIENT_ID=your_client_id_here

# Идентификатор сервера (гильдии) для деплоя slash-команд
GUILD_ID=your_guild_id_here

# Идентификаторы ролей Discord (RBAC)
# Роль, дающая доступ к привилегированным командам (регистрация, записи, ЭМК)
ROLE_MEDICAL_STAFF=your_medical_staff_role_id
# Дополнительные служебные роли (опционально)
ROLE_ADMIN=your_admin_role_id

# Путь к файлу базы данных SQLite
DB_PATH=./data/emias.db

# Уровень логирования: debug | info | warn | error
LOG_LEVEL=info