# ============================================================
# ЕМИАС — переменные окружения сервера (API-шлюза).
# Скопируйте в .env и заполните реальными значениями.
# Файл .env с секретами НЕ коммитится (.gitignore).
# ============================================================

# Порт HTTP-сервера API-шлюза
PORT=3000

# Публичный базовый URL (используется для redirect_uri Discord OAuth2)
PUBLIC_BASE_URL=https://emias-git-main-yeolka-lm.vercel.app

# ------------------------------------------------------------
# База данных — PostgreSQL (Neon).
# Берите обе строки в панели Neon → Project Settings → Database.
# DATABASE_URL — через пулер (для обычных запросов сайта/API).
# DATABASE_URL_UNPOOLED — прямое соединение (для prisma db push/migrate).
# ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Уровень логирования: debug | info | warn | error
LOG_LEVEL=info

# ------------------------------------------------------------
# Discord OAuth2 (https://discord.com/developers/applications)
# В настройках приложения → OAuth2 добавьте Redirect URI:
#   {PUBLIC_BASE_URL}/auth/callback
# Scopes: identify
# Секрет — ТОЛЬКО здесь, никогда в клиентском коде.
# ------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Точный redirect URI, зарегистрированный в Discord-приложении (совпадает с PUBLIC_BASE_URL + /auth/callback):
OAUTH_REDIRECT_URI=https://emias-git-main-yeolka-lm.vercel.app/auth/callback
# Пример сгенерированной ссылки входа (state/code_challenge сайт добавляет сам):
# https://discord.com/oauth2/authorize?client_id=1541136822996832266&response_type=code&redirect_uri=https%3A%2F%2Femias-git-main-yeolka-lm.vercel.app%2Fauth%2Fcallback&scope=identify

# Discord ID пользователей, которые при первом входе получают
# роль «Главный врач» (через запятую)
ADMIN_DISCORD_IDS=

# Внутренний ключ для /internal/* API (шлюз бот↔сайт).
# Если пуст — генерируется случайный при старте (нестабильно между перезапусками).
INTERNAL_API_KEY=

# ------------------------------------------------------------
# ТОЛЬКО для локальной разработки без настроенного OAuth2:
# включает POST /auth/dev-login (автовход демо-врачом).
# На «боевом» сервере обязательно NODE_ENV=production или DEV_LOGIN=0.
# ------------------------------------------------------------
DEV_LOGIN=1

# Доп. интеграции (необязательно):
# STAFF_LOG_CHANNEL_ID=
# DISCORD_WEBHOOK_APPOINTMENTS=
# DISCORD_WEBHOOK_CARDS=
# CARD_FORUM_CHANNEL_ID=
